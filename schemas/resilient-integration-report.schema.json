{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resilient-foundation:schema:resilient-integration-report:v1",
  "title": "resilient-integration-report",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1.0-draft"
    },
    "kind": {
      "const": "resilient_integration_report"
    },
    "format": {
      "const": "foundation-resilient-integration-report-v2"
    },
    "status": {
      "const": "passed"
    },
    "scope": {
      "const": "resilient_contract_certificate_e2e"
    },
    "evidence_class": {
      "const": "solver_checked"
    },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proof_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementation_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "test_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "driver_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "evidence_files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "tests_run": {
      "type": "integer",
      "minimum": 1
    },
    "tests_failed": {
      "const": 0
    },
    "tests_skipped": {
      "const": 0
    },
    "mutation": {
      "type": "object",
      "properties": {
        "status": {
          "const": "rejected"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claim_scope": {
      "const": "smt_queries"
    },
    "source_binding": {
      "const": "regenerated"
    },
    "inventoried_capability_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "const": "passed"
          },
          "outcome": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "replay": {
      "type": "object"
    },
    "receipt": {
      "type": "object"
    },
    "build": {
      "type": "object"
    },
    "emit": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "kind",
    "format",
    "status",
    "scope",
    "evidence_class",
    "capability_ids",
    "inventory_sha256",
    "source_sha256",
    "certificate_sha256",
    "proof_manifest_sha256",
    "implementation_hashes",
    "test_hashes",
    "driver_hashes",
    "evidence_files",
    "tests_run",
    "tests_failed",
    "tests_skipped",
    "mutation",
    "assumptions",
    "claim_scope",
    "source_binding",
    "inventoried_capability_ids",
    "cases",
    "replay",
    "receipt",
    "build",
    "emit"
  ],
  "additionalProperties": false
}

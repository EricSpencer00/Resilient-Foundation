{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:resilient-foundation:schema:obligation:v1",
  "title": "obligation",
  "type": "object",
  "properties": {
    "version": {
      "const": "0.1.0-draft"
    },
    "kind": {
      "const": "obligation"
    },
    "illustrative": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "maxLength": 100
    },
    "task_kind": {
      "enum": [
        "safety",
        "equivalence",
        "refinement",
        "reachability",
        "temporal",
        "hyper",
        "graph",
        "probability",
        "statistical",
        "recovery",
        "resource",
        "regression",
        "source_to_ir",
        "ir_to_bytecode",
        "ir_to_rust",
        "native_translation"
      ]
    },
    "relation": {
      "enum": [
        "observable_equivalence",
        "refinement",
        "property"
      ]
    },
    "source_artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "maxLength": 100
    },
    "target_artifact_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "semantic_profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
      "maxLength": 100
    },
    "observation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "quantifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "maxLength": 100
      },
      "minItems": 1
    },
    "analysis_bounds": {
      "type": "object",
      "properties": {
        "steps": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "states": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "faults": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "steps",
        "states",
        "faults"
      ],
      "additionalProperties": false
    },
    "required_evidence_class": {
      "enum": [
        "solver_checked",
        "kernel_checked",
        "translation_checked"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$",
        "maxLength": 100
      },
      "minItems": 0
    },
    "statement": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "kind",
    "illustrative",
    "id",
    "task_kind",
    "relation",
    "source_artifact_id",
    "target_artifact_id",
    "semantic_profile_id",
    "observation",
    "quantifiers",
    "requirements",
    "analysis_bounds",
    "required_evidence_class",
    "assumptions",
    "dependencies",
    "statement"
  ],
  "additionalProperties": false
}

(set-logic QF_BV)
(set-option :produce-models true)
(set-option :timeout 10000)
(declare-fun p0 () (_ BitVec 64))
(define-fun s0v () (_ BitVec 64) p0)
(define-fun s0e () Bool false)
(define-fun s1v () (_ BitVec 64) (_ bv0 64))
(define-fun s1e () Bool false)
(define-fun s2v () Bool (bvsge s0v s1v))
(define-fun s2e () Bool (or s0e s1e))
(define-fun s3v () (_ BitVec 64) p0)
(define-fun s3e () Bool false)
(define-fun s4v () (_ BitVec 64) (_ bv0 64))
(define-fun s4e () Bool false)
(define-fun s5v () (_ BitVec 64) (ite s2v s3v s4v))
(define-fun s5e () Bool (or s2e (ite s2v s3e s4e)))
(define-fun c0v () (_ BitVec 64) p0)
(define-fun c0e () Bool false)
(define-fun c1v () (_ BitVec 64) (_ bv0 64))
(define-fun c1e () Bool false)
(define-fun c2v () Bool (bvsge c0v c1v))
(define-fun c2e () Bool (or c0e c1e))
(define-fun c3v () (_ BitVec 64) p0)
(define-fun c3e () Bool false)
(define-fun c4v () (_ BitVec 64) (_ bv0 64))
(define-fun c4e () Bool false)
(define-fun c5v () (_ BitVec 64) (ite c2v c3v c4v))
(define-fun c5e () Bool (or c2e (ite c2v c3e c4e)))
(assert (or (xor s5e c5e) (and (not s5e) (not c5e) (not (= s5v c5v)))))
(check-sat)
